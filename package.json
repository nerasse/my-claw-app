{
  "name": "MyClawApp",
  "version": "0.6.245",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "build:web": "bash scripts/build-web.sh",
    "build:codeditor": "node scripts/build-codeditor.js",
    "ios": "react-native run-ios",
    "lint": "eslint . --max-warnings 0",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run check:native && npm test",
    "check:native": "node scripts/check-native-deps.js",
    "postinstall": "node scripts/apply-dependency-patches.cjs",
    "check:dependency-patches": "node scripts/apply-dependency-patches.cjs --check && node --test scripts/tests/test_dependency_security.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@expo/metro-runtime": "^57.0.10",
    "@likashefqet/react-native-image-zoom": "^4.3.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-documents/picker": "^12.0.2",
    "@tanstack/react-virtual": "3.14.26",
    "@uiw/react-codemirror": "^4.25.11",
    "codemirror": "^6.0.2",
    "cronstrue": "^3.24.0",
    "expo": "~57.0.11",
    "expo-camera": "^57.0.3",
    "expo-modules-core": "~57.0.10",
    "expo-unified-push": "^0.6.0",
