    "pdfjs-dist": "6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "^3.1.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-marked": "^8.1.1",
    "react-native-reanimated": "^4.5.3",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "^0.11.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "esbuild": "^0.25.12",
    "eslint": "^8.57.1",
    "eslint-plugin-ft-flow": "^3.0.11",
    "jest": "^29.6.3",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.8",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "overrides": {
    "react-native-worklets": "$react-native-worklets",
    "shell-quote": "^1.12.0",
    "compression": "^1.8.2",
    "joi": "^17.13.8",
    "qs": "^6.16.0",
    "source-map-js": "^1.2.2",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@5": "^5.0.12",
    "js-yaml@3": "^3.15.2",
    "@xmldom/xmldom@0.8": "^0.8.15",
    "@xmldom/xmldom@0.9": "^0.9.12",
    "js-yaml@4": "^4.3.2"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-asset",
        "expo-constants",
        "expo-file-system",
        "expo-font",
        "expo-keep-awake",
        "@expo/dom-webview",
        "@expo/log-box"
      ]
    }
  },
  "license": "MIT",
  "description": "Android and web client for my-claw, a self-hosted AI agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerasse/my-claw-app.git"
  },
  "author": "Yassir EL KSSIMI",
  "keywords": [
    "ai",
    "agent",
    "react-native",
    "android",
    "self-hosted"
  ]
}
